# Salin file ini ke .env (cp .env.example .env) lalu isi nilainya.
# PENTING: Jangan pernah commit file .env ke git repo.

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# 1. AUTENTIKASI WEBHOOK META (WAJIB UNTUK MENERIMA PESAN)
# -----------------------------------------------------------------------------

# String rahasia bebas buatanmu sendiri untuk verifikasi webhook.
# Isi string yang sama persis di:
# Meta for Developers > My Apps > WhatsApp > Configuration > Edit Webhook > "Verify token"
VERIFY_TOKEN=ganti-dengan-string-acak-panjang

# App Secret aplikasi Meta untuk memvalidasi signature HMAC-SHA256 (X-Hub-Signature-256).
# Lokasi mendapatkan:
# Meta for Developers (https://developers.facebook.com) > My Apps > [Pilih Aplikasi] 
# > App settings > Basic > "App secret" (klik "Show" / "Tampilkan")
APP_SECRET=

# -----------------------------------------------------------------------------
# 2. WHATSAPP CLOUD API (UNTUK MENGIRIM PESAN, BALAS CHAT, FILE & CENTANG BIRU)
# -----------------------------------------------------------------------------

# Token akses untuk memanggil Meta Graph API (mengirim teks, upload file, dan mark-as-read).
# Dimana mendapatkannya:
#
# A. Untuk Pengujian / Dev (Temporary Token - berlaku 24 jam):
#    1. Buka https://developers.facebook.com > My Apps > [Aplikasi Anda]
#    2. Di menu kiri, pilih "WhatsApp" > "API Setup"
#    3. Salin nilai pada kotak "Temporary access token" (berawalan EAA...)
#
# B. Untuk Produksi (Permanent Token - tidak pernah kedaluwarsa):
#    1. Buka Meta Business Manager: https://business.facebook.com/settings
#    2. Masuk ke menu "Users" (Pengguna) > "System Users" (Pengguna Sistem)
#    3. Tambah System User baru (Pilih Role: Admin)
#    4. Klik "Add Assets", pilih aplikasi WhatsApp Anda dan berikan akses penuh
#    5. Klik "Generate new token", pilih aplikasi WhatsApp
#    6. Pilih masa berlaku token: "Never" (Permanen)
#    7. Centang 2 izin penting (permissions):
#       - whatsapp_business_messaging
#       - whatsapp_business_management
#    8. Klik "Generate Token" lalu salin token ke variabel di bawah:
META_ACCESS_TOKEN=

# ID Nomor Telepon WhatsApp Bisnis Anda (Phone Number ID).
# Dimana mendapatkannya:
# 1. Buka https://developers.facebook.com > My Apps > [Aplikasi Anda]
# 2. Di menu kiri, klik "WhatsApp" > "API Setup"
# 3. Pada langkah "Step 1: Select phone numbers", lihat label "Phone number ID"
#    (berupa angka, contoh: 106540352242922)
# CATATAN: Jangan tertukar dengan "WhatsApp Business Account ID" (WABA ID).
META_PHONE_NUMBER_ID=

# Versi Meta Graph API yang digunakan (default: v21.0)
# Dapat dicek di App settings > Advanced > Graph API Version
META_API_VERSION=v21.0

# -----------------------------------------------------------------------------
# 3. PENYIMPANAN DATABASE POSTGRESQL & SESI
# -----------------------------------------------------------------------------

# URL koneksi PostgreSQL untuk menyimpan kontak, pesan histori, dan log webhook.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# Jika dikosongkan, aplikasi otomatis menggunakan MemoryMessageRepository (in-memory dev fallback).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_webhook

# Kunci rahasia untuk menandatangani cookie sesi login admin (HMAC-SHA256).
# Ganti dengan string acak panjang di production.
SESSION_SECRET=kunci-rahasia-sesi-acak-panjang

# -----------------------------------------------------------------------------
# 4. KREDENSIAL AWAL AKUN LOGIN ADMIN
# -----------------------------------------------------------------------------
# Saat database baru diinisialisasi pertama kali, akun awal otomatis di-seed ke tabel 'accounts':
# Username default: admin
# Password default: admin123
# (Opsional diubah sebelum seeding pertama: INITIAL_ADMIN_USERNAME dan INITIAL_ADMIN_PASSWORD)
