# Salin ke .env lalu isi. Jangan commit .env.

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# String bebas pilihanmu; isi yang sama di App Dashboard > WhatsApp > Configuration > Verify token
VERIFY_TOKEN=ganti-dengan-string-acak-panjang

# App Dashboard > App settings > Basic > App secret
APP_SECRET=

# Database PostgreSQL untuk menyimpan akun, pesan, pengirim, dan riwayat status
# Contoh: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_webhook

# Kunci penandatanganan cookie sesi (HMAC-SHA256)
SESSION_SECRET=kunci-rahasia-sesi-acak-panjang

# WhatsApp Cloud API (Opsional: untuk mengirim status 'read' / centang dua biru ke WhatsApp pelanggan)
META_ACCESS_TOKEN=
META_API_VERSION=v21.0
META_PHONE_NUMBER_ID=

# Catatan akun login:
# Kredensial akun (username & password hash) disimpan di tabel database 'accounts'.
# Saat database baru diinisialisasi pertama kali, akun awal otomatis dibuat:
# Username: admin, Password: admin123
# (Opsional: dapat disesuaikan saat seeding awal dengan INITIAL_ADMIN_USERNAME dan INITIAL_ADMIN_PASSWORD)
